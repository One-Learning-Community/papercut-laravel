{
    "name": "papercut/laravel",
    "description": "Blade components that compile to Papercut's PDF layout engine.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/One-Learning-Community/papercut",
    "support": {
        "issues": "https://github.com/One-Learning-Community/papercut/issues",
        "source": "https://github.com/One-Learning-Community/papercut"
    },
    "authors": [
        {
            "name": "One Learning Community",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true,
                "versions": {
                    "papercut/core": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "papercut/core": "^0.1"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^3.1",
        "orchestra/testbench": "^11.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Papercut\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Papercut\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Papercut\\Laravel\\PapercutServiceProvider"
            ],
            "aliases": {
                "Papercut": "Papercut\\Laravel\\Facades\\Papercut"
            }
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "pdf",
        "laravel",
        "blade",
        "pdf-generator",
        "invoice",
        "report"
    ]
}
