{
    "name": "quoin/laravel",
    "description": "Blade views to page-aware PDF, Word, and HTML documents, laid out by quoin/core.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/One-Learning-Community/quoin",
    "support": {
        "issues": "https://github.com/One-Learning-Community/quoin/issues",
        "source": "https://github.com/One-Learning-Community/quoin",
        "docs": "https://one-learning-community.github.io/quoin/laravel/"
    },
    "authors": [
        {
            "name": "One Learning Community",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true,
                "versions": {
                    "quoin/core": "0.20.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../docx",
            "options": {
                "symlink": true,
                "versions": {
                    "quoin/docx": "0.20.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "quoin/core": "^0.20",
        "phactorial/phactorial": "^0.21"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^3.1",
        "orchestra/testbench": "^11.3",
        "quoin/docx": "^0.20",
        "phiki/phiki": "^2.2",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "phiki/phiki": "Syntax highlighting in code blocks (TextMate grammars and themes)",
        "quoin/docx": "Word (.docx) export: ->docx() and ?format=docx previews"
    },
    "autoload": {
        "psr-4": {
            "Quoin\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quoin\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quoin\\Laravel\\QuoinServiceProvider"
            ],
            "aliases": {
                "Quoin": "Quoin\\Laravel\\Facades\\Quoin"
            }
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "pdf",
        "laravel",
        "blade",
        "pdf-generator",
        "invoice",
        "report"
    ]
}
